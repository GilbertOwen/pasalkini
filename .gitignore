# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
*.egg-info/

# Secrets
.env
.env.*
!.env.example

# Data is rebuilt by the pipeline from sources/manifest.yaml
data/*
!data/README.md

# Eval runs: keep only the summaries and the grades given by reading the answers
evals/runs/*/*
!evals/runs/*/summary.md
!evals/runs/*/config.json
!evals/runs/*/grading.csv
!evals/runs/*/grades-*.csv
!evals/runs/*/judge*.csv

# Editors and tools
.vscode/
.idea/
.claude/
.ipynb_checkpoints/
